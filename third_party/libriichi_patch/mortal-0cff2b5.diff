diff --git a/libriichi/src/state/raw.rs b/libriichi/src/state/raw.rs
new file mode 100755
index 0000000..643ea80
--- /dev/null
+++ b/libriichi/src/state/raw.rs
@@ -0,0 +1,268 @@
+use super::item::{KawaItem, Sutehai};
+use super::PlayerState;
+use crate::must_tile;
+use crate::tile::Tile;
+
+use pyo3::prelude::*;
+use tinyvec::{ArrayVec, TinyVec};
+
+/// A per-decision-point snapshot of the observable game state, mirroring the
+/// raw fields consumed by the LLM4CardGame riichi data pipeline
+/// (`util/mahjong_util/gen_action_data.py` and `util/mortal_util/llm_engine.py`).
+///
+/// Fields accessed without parentheses from Python are plain attributes (raw
+/// values copied from `PlayerState`); fields accessed with parentheses are
+/// methods that convert internal values such as `Tile` into mjai tile strings
+/// (e.g. `"1m"`, `"5mr"`, `"E"`).
+#[pyclass]
+#[derive(Clone)]
+pub struct RawObsEvent {
+    #[pyo3(get)]
+    player_id: u8,
+    #[pyo3(get)]
+    kyoku: u8,
+    #[pyo3(get)]
+    honba: u8,
+    #[pyo3(get)]
+    kyotaku: u8,
+    #[pyo3(get)]
+    is_oya: bool,
+    #[pyo3(get)]
+    scores: [i32; 4],
+    #[pyo3(get)]
+    rank: u8,
+    #[pyo3(get)]
+    at_turn: u8,
+    #[pyo3(get)]
+    tiles_left: u8,
+    #[pyo3(get)]
+    shanten: i8,
+    tehai: [u8; 34],
+    #[pyo3(get)]
+    akas_in_hand: [bool; 3],
+    doras_owned: [u8; 4],
+    #[pyo3(get)]
+    doras_seen: u8,
+    #[pyo3(get)]
+    akas_seen: [bool; 3],
+    #[pyo3(get)]
+    riichi_declared: [bool; 4],
+    #[pyo3(get)]
+    riichi_accepted: [bool; 4],
+    #[pyo3(get)]
+    can_w_riichi: bool,
+    #[pyo3(get)]
+    is_w_riichi: bool,
+    #[pyo3(get)]
+    at_furiten: bool,
+    #[pyo3(get)]
+    is_menzen: bool,
+
+    bakaze: Tile,
+    jikaze: Tile,
+    waits: [bool; 34],
+    dora_indicators: ArrayVec<[Tile; 5]>,
+    tiles_seen: [u8; 34],
+    keep_shanten_discards: [bool; 34],
+    next_shanten_discards: [bool; 34],
+    ankan_candidates: ArrayVec<[Tile; 3]>,
+    kakan_candidates: ArrayVec<[Tile; 3]>,
+    kawa: [TinyVec<[Option<KawaItem>; 24]>; 4],
+    kawa_overview: [ArrayVec<[Tile; 24]>; 4],
+    fuuro_overview: [ArrayVec<[ArrayVec<[Tile; 4]>; 4]>; 4],
+    ankan_overview: [ArrayVec<[Tile; 4]>; 4],
+    last_tedashis: [Option<Sutehai>; 4],
+    riichi_sutehais: [Option<Sutehai>; 4],
+    last_self_tsumo: Option<Tile>,
+    last_kawa_tile: Option<Tile>,
+}
+
+#[pymethods]
+impl RawObsEvent {
+    // `[u8; N]` would be converted to Python `bytes` by pyo3, which is not
+    // JSON serializable and thus breaks the paper's `json.dumps` in
+    // `gen_action_data.py`; expose them as lists of ints instead.
+    #[getter]
+    fn tehai(&self) -> Vec<i32> {
+        self.tehai.iter().map(|&x| i32::from(x)).collect()
+    }
+
+    #[getter]
+    fn doras_owned(&self) -> Vec<i32> {
+        self.doras_owned.iter().map(|&x| i32::from(x)).collect()
+    }
+
+    fn bakaze(&self) -> String {
+        self.bakaze.to_string()
+    }
+
+    fn jikaze(&self) -> String {
+        self.jikaze.to_string()
+    }
+
+    fn waits(&self) -> Vec<String> {
+        self.waits
+            .iter()
+            .enumerate()
+            .filter(|&(_, &b)| b)
+            .map(|(i, _)| must_tile!(i).to_string())
+            .collect()
+    }
+
+    fn dora_indicators(&self) -> Vec<String> {
+        self.dora_indicators
+            .iter()
+            .map(|t| t.to_string())
+            .collect()
+    }
+
+    fn tiles_seen(&self) -> Vec<String> {
+        let mut ret = Vec::new();
+        for (i, &cnt) in self.tiles_seen.iter().enumerate() {
+            for _ in 0..cnt {
+                ret.push(must_tile!(i).to_string());
+            }
+        }
+        ret
+    }
+
+    fn keep_shanten_discards(&self) -> Vec<String> {
+        self.keep_shanten_discards
+            .iter()
+            .enumerate()
+            .filter(|&(_, &b)| b)
+            .map(|(i, _)| must_tile!(i).to_string())
+            .collect()
+    }
+
+    fn next_shanten_discards(&self) -> Vec<String> {
+        self.next_shanten_discards
+            .iter()
+            .enumerate()
+            .filter(|&(_, &b)| b)
+            .map(|(i, _)| must_tile!(i).to_string())
+            .collect()
+    }
+
+    fn ankan_candidates(&self) -> Vec<String> {
+        self.ankan_candidates
+            .iter()
+            .map(|t| t.to_string())
+            .collect()
+    }
+
+    fn kakan_candidates(&self) -> Vec<String> {
+        self.kakan_candidates
+            .iter()
+            .map(|t| t.to_string())
+            .collect()
+    }
+
+    fn kawa(&self) -> Vec<Vec<Option<String>>> {
+        self.kawa
+            .iter()
+            .map(|p| {
+                p.iter()
+                    .map(|item| item.as_ref().map(|i| i.to_string()))
+                    .collect()
+            })
+            .collect()
+    }
+
+    fn kawa_overview(&self) -> Vec<Vec<String>> {
+        self.kawa_overview
+            .iter()
+            .map(|p| p.iter().map(|t| t.to_string()).collect())
+            .collect()
+    }
+
+    fn fuuro_overview(&self) -> Vec<Vec<Vec<String>>> {
+        self.fuuro_overview
+            .iter()
+            .map(|p| {
+                p.iter()
+                    .map(|m| m.iter().map(|t| t.to_string()).collect())
+                    .collect()
+            })
+            .collect()
+    }
+
+    fn ankan_overview(&self) -> Vec<Vec<String>> {
+        self.ankan_overview
+            .iter()
+            .map(|p| p.iter().map(|t| t.to_string()).collect())
+            .collect()
+    }
+
+    fn last_tedashis(&self) -> Vec<Option<String>> {
+        self.last_tedashis
+            .iter()
+            .map(|o| o.as_ref().map(|s| s.to_string()))
+            .collect()
+    }
+
+    fn riichi_sutehais(&self) -> Vec<Option<String>> {
+        self.riichi_sutehais
+            .iter()
+            .map(|o| o.as_ref().map(|s| s.to_string()))
+            .collect()
+    }
+
+    fn last_self_tsumo(&self) -> Option<String> {
+        self.last_self_tsumo.map(|t| t.to_string())
+    }
+
+    fn last_kawa_tile(&self) -> Option<String> {
+        self.last_kawa_tile.map(|t| t.to_string())
+    }
+}
+
+impl PlayerState {
+    /// Snapshot the fields consumed by the LLM4CardGame riichi pipeline.
+    ///
+    /// Called from `dataset::Gameplay::add_entry` so that the snapshot index
+    /// (`Gameplay::take_obs_raw`) stays aligned with `take_obs` / `take_masks`
+    /// / `take_actions`, including the extra kan-select entries.
+    pub(crate) fn snapshot_raw(&self) -> RawObsEvent {
+        RawObsEvent {
+            player_id: self.player_id,
+            kyoku: self.kyoku,
+            honba: self.honba,
+            kyotaku: self.kyotaku,
+            is_oya: self.oya == 0,
+            scores: self.scores,
+            rank: self.rank,
+            at_turn: self.at_turn,
+            tiles_left: self.tiles_left,
+            shanten: self.shanten,
+            tehai: self.tehai,
+            akas_in_hand: self.akas_in_hand,
+            doras_owned: self.doras_owned,
+            doras_seen: self.doras_seen,
+            akas_seen: self.akas_seen,
+            riichi_declared: self.riichi_declared,
+            riichi_accepted: self.riichi_accepted,
+            can_w_riichi: self.can_w_riichi,
+            is_w_riichi: self.is_w_riichi,
+            at_furiten: self.at_furiten,
+            is_menzen: self.is_menzen,
+            bakaze: self.bakaze,
+            jikaze: self.jikaze,
+            waits: self.waits,
+            dora_indicators: self.dora_indicators.clone(),
+            tiles_seen: self.tiles_seen,
+            keep_shanten_discards: self.keep_shanten_discards,
+            next_shanten_discards: self.next_shanten_discards,
+            ankan_candidates: self.ankan_candidates.clone(),
+            kakan_candidates: self.kakan_candidates.clone(),
+            kawa: self.kawa.clone(),
+            kawa_overview: self.kawa_overview.clone(),
+            fuuro_overview: self.fuuro_overview.clone(),
+            ankan_overview: self.ankan_overview.clone(),
+            last_tedashis: self.last_tedashis,
+            riichi_sutehais: self.riichi_sutehais,
+            last_self_tsumo: self.last_self_tsumo,
+            last_kawa_tile: self.last_kawa_tile,
+        }
+    }
+}
